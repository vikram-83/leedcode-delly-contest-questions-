class Solution {
public:
    int maximumSubarray(vector<int>& arr) {

        int n = arr.size();

        int noSquare = arr[0];
        int oneSquare = arr[0] * arr[0];

        int ans = max(noSquare, oneSquare);

        for (int i = 1; i < n; i++) {

            int x = arr[i];

            int newOneSquare = max({
                x * x,
                noSquare + x * x,
                oneSquare + x
            });

            int newNoSquare = max(
                x,
                noSquare + x
            );

            noSquare = newNoSquare;
            oneSquare = newOneSquare;

            ans = max(ans, max(noSquare, oneSquare));
        }

        return ans;
    }

Input: arr[] =  [-1, -2, 3, -2, 3]
Output: 10
Explanation: The subarray {3, -2, 3} with squaring -2 will give the maximum sum as 3 + 4 + 3 = 10.
};
