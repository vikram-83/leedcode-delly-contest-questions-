
class Solution {
public:
    bool canAliceWin(int n) {

        int stonesToRemove = 10;
        bool aliceTurn = true;

        while (n > 0 && stonesToRemove > 0 &&
               n >= stonesToRemove) {

            n = n - stonesToRemove;

            stonesToRemove--;

            aliceTurn = !aliceTurn;
        }

        return !aliceTurn;
    }
};
