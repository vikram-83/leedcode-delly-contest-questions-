class Solution {
public:
    long long minimumCost(int cost1, int cost2, int costBoth,
                          int need1, int need2) {

        // Case 1: Buy individual items
        long long option1 = 1LL * need1 * cost1
                          + 1LL * need2 * cost2;

        // Case 2: Buy only Type 3 items
        long long option2 = 1LL * max(need1, need2) * costBoth;

        // Case 3: Buy Type 3 for common requirement,
        // then buy individual items for remaining requirement
        long long option3 = 1LL * min(need1, need2) * costBoth;

        if (need1 > need2) {
            option3 += 1LL * (need1 - need2) * cost1;
        }
        else {
            option3 += 1LL * (need2 - need1) * cost2;
        }

        return min({option1, option2, option3});
    }
};
